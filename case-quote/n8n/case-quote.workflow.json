      "parameters": {
        "jsCode": "const d = $('Decide').first().json;\nconst r = $input.first().json;\nconst err = (r.body && r.body.error) || {};\nreturn [{ json: {\n  emailSubject: 'Case quote: ' + (d.route === 'create' ? 'could not make the folder' : 'could not start Google') + ' for ' + d.caseName,\n  emailBody: `Someone pressed ${d.route === 'create' ? 'Create Quote' : 'Start reading'} on ${d.caseName}.\\n\\n` +\n    `HTTP ${r.statusCode} \u00b7 ${String(err.status || '')} \u00b7 ${String(err.message || '').slice(0, 200)}\\n\\n` +\n    'Most likely cause: a Google credential in n8n needs reconnecting.' } }];"
