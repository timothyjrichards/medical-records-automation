    {
      "id": "e3d9e33c-4f22-4f80-987b-d3cca1abd45e",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// Decides what a press does. Only ids, the case name and counts pass through n8n: it never lists\n// or opens the uploaded files or the filled quote sheet (patient data).\nconst str = (v) => String(v == null ? '' : v).trim();\nconst body = $('Quote Webhook').first().json.body || {};\nconst action = str(body.action);\nconst threadId = str(body.threadId);\nconst row = $('Get Prospect').first().json || {};\nconst out = {\n  action, threadId,\n  rowNumber: row.row_number,\n  caseName: str(row['Case Name']) || 'Untitled case',\n  folderId: str(row.FolderID_Quote),\n  sheetId: str(row.FileID_Quote),\n  status: str(row.Status_Quote),\n};\nconst refuse = (message) => ({ ...out, route: 'reply', reply: { ok: false, message } });\n\n// A second press within a minute is a double click.\nconst sd = $getWorkflowStaticData('global');\nsd.recent = sd.recent || {};\nconst key = action + ':' + threadId;\nconst now = Date.now();\nfor (const k of Object.keys(sd.recent)) if (now - sd.recent[k] > 60000) delete sd.recent[k];\n\nlet result;\nif (!threadId || !row.row_number || str(row.ThreadID) !== threadId) {\n  result = refuse(\"Couldn't find this case in the case tracker.\");\n} else if (action === 'create') {\n  if (out.folderId && out.sheetId) {\n    result = { ...out, route: 'reply', reply: { ok: true, folderId: out.folderId, sheetId: out.sheetId } };\n  } else if (sd.recent[key]) {\n    result = refuse('Already making the folder. Give it a few seconds.');\n  } else {\n    result = { ...out, route: 'create' };\n  }\n} else if (action === 'start') {\n  // A reading normally takes minutes; after 10 hours a Running line is stale and may be retried.\n  const m = /^Running \u00b7 started (\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2})/.exec(out.status);\n  const started = m ? DateTime.fromFormat(m[1], 'yyyy-MM-dd HH:mm', { zone: 'America/New_York' }) : null;\n  if (!out.folderId || !out.sheetId) {\n    result = refuse('Press Create Quote first.');\n  } else if (sd.recent[key] || (started && started.isValid && now - started.toMillis() < 10 * 3600 * 1000)) {\n    result = refuse('Already reading this case. See Quote appears when it is done.');\n  } else {\n    result = { ...out, route: 'start' };\n  }\n} else {\n  result = refuse('Unknown request.');\n}\nif (result.route !== 'reply') sd.recent[key] = now;\nreturn [{ json: result }];"
      }
    },
