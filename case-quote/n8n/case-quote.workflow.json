    {
      "id": "708656e1-bc53-427c-8823-924834ca4e4e",
      "name": "Build Done Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        400
      ],
      "parameters": {
        "jsCode": "// Turns Google's answer into the status line the user sees. Counts only.\nconst str = (v) => String(v == null ? '' : v).trim();\nconst d = $('Decide').first().json;\nconst check = $input.first().json;   // Check Run's last answer\nconst today = $now.setZone('America/New_York').toFormat('yyyy-MM-dd');\nconst n = (x) => Number(x || 0).toLocaleString('en-US');\nconst STAGES = {\n  no_pdf_files: 'no PDFs in the folder',\n  no_readable_pages: \"the PDFs couldn't be opened\",\n  too_many_pages: 'over 20,000 pages',\n  not_a_quote_sheet: \"the quote sheet's layout was changed\",\n  too_many_sections_unread: \"Google's AI was too busy, try again later\",\n};\n// Plain words for the admin's email. Codes come from Google; none of this holds record data.\nconst why = (code) => ({\n  429: \"Google's AI was too busy and turned the requests away (error 429).\",\n  400: \"Google's AI refused a section as invalid (error 400). Trying again won't help; it needs a look.\",\n  403: \"Google refused permission (error 403). A setting needs checking; trying again won't help.\",\n}[code] || ([500, 502, 503, 504].includes(code) ? `Google's AI had a temporary problem on its side (error ${code}).` :\n  code ? `Google's AI answered with error ${code}.` : \"Google's AI gave no usable answer, or no error code was recorded.\"));\nconst WHAT = {\n  too_many_sections_unread: 'Too many sections went unread (more than 1 in 10), so no quote was written.',\n  ai_read: \"The AI couldn't read a section after all its tries, so no quote was written.\",\n  ai_read_careful: \"The AI's careful reading of a billing section failed after all its tries, so no quote was written.\",\n  ai_unreadable_answer: \"The AI's answer for a section was garbled every time, so no quote was written.\",\n  ai_incomplete_answer: 'The AI kept cutting its answer short on a section, so no quote was written.',\n};\nlet result = {}, state = '';\nif (check.statusCode === 200 && check.body) {\n  state = str(check.body.state);\n  try { result = JSON.parse(check.body.result || '{}'); } catch (e) { result = {}; }\n}\nlet status, alertAdmin = false, detail = '', subject = 'Case quote stopped: ' + d.caseName, opening = `The quote reading for ${d.caseName} stopped.`;\nif (state === 'SUCCEEDED' && result.status === 'done') {\n  // The quote sheet sits in the same folder, so one non-PDF file is always the sheet itself.\n  const skipped = Math.max(0, Number(result.files_not_pdf || 0) - 1) + Number(result.files_unreadable || 0);\n  status = `Done ${today} \u00b7 ${n(result.providers)} providers \u00b7 ${n(result.pages)} pages \u00b7 ${n(result.billing_lines)} lines` +\n    (skipped ? ` \u00b7 ${skipped} file${skipped === 1 ? '' : 's'} not read` : '') +\n    (result.pages_not_read ? ` \u00b7 ${n(result.pages_not_read)} pages the AI could not read` : '') +\n    (result.zip_files ? ` \u00b7 ${n(result.zip_files)} zip file${result.zip_files === 1 ? '' : 's'}: check they were unzipped` : '');\n  if (result.zip_files && !result.sections_not_read) {\n    alertAdmin = true;\n    subject = 'Case quote finished, check the zip files: ' + d.caseName;\n    opening = `The quote for ${d.caseName} finished, but the folder has ${n(result.zip_files)} zip file${result.zip_files === 1 ? '' : 's'}. The reader can't open zip files. ` +\n      'If they were not unzipped into the folder, the quote is too low: unzip them and press Start reading again. If they were, this is fine.';\n  }\n  if (result.sections_not_read) {\n    alertAdmin = true;\n    subject = 'Case quote finished with a gap: ' + d.caseName;\n    opening = `The quote for ${d.caseName} finished, but ${n(result.pages_not_read)} of its ${n(result.pages)} pages went unread ` +\n      `(${n(result.sections_not_read)} of ${n(result.chunks)} sections).\\n\\nWhy: ${why(Number(result.ai_http_status))}\\n` +\n      `Those pages are on the \"Other pages \u2013 AI could not read\" row, and the Where Found tab shows which file and pages. ` +\n      `The provider and billing counts may be low. Pressing Start reading again re-reads the whole case.` +\n      (result.zip_files ? `\\n\\nThe folder also has ${n(result.zip_files)} zip file(s), which the reader can't open. Check they were unzipped.` : '');\n    detail = `stage ${str(result.ai_stage) || '-'}, error ${str(result.ai_http_status) || 'none recorded'}`;\n  }\n} else if (state === 'SUCCEEDED' && STAGES[result.status === 'failed' ? result.stage : '']) {\n  status = `Stopped ${today} \u00b7 ${STAGES[result.stage]}`;\n  alertAdmin = result.stage !== 'no_pdf_files';\n  detail = 'stage ' + result.stage + (result.http_status ? ', error ' + result.http_status : '');\n  if (WHAT[result.stage]) opening += `\\n\\nWhat happened: ${WHAT[result.stage]}\\nWhy: ${why(Number(result.http_status))}\\n` +\n    'What to do: press Start reading again. Early morning has been the quietest time for the AI.';\n} else {\n  status = `Stopped ${today} \u00b7 something went wrong \u00b7 admin emailed`;\n  alertAdmin = true;\n  if (WHAT[result.stage]) opening += `\\n\\nWhat happened: ${WHAT[result.stage]}\\nWhy: ${why(Number(result.http_status))}\\n` +\n    'What to do: press Start reading again. Early morning has been the quietest time for the AI.';\n  detail = state ? `Google state ${state}, stage ${str(result.stage) || '-'}` + (result.http_status ? `, error ${result.http_status}` : '') :\n    `n8n could not read the Google run (HTTP ${check.statusCode}) after about 10 hours of checks`;\n}\nreturn [{ json: { status, alertAdmin,\n  emailSubject: subject,\n  emailBody: `${opening}\\n\\nDetail: ${detail}\\nGoogle run: ${str($('Start Google Run').first().json.body?.name)}\\n` +\n    `Quote sheet: https://docs.google.com/spreadsheets/d/${d.sheetId}\\n\\nThe case row now says: ${status}` } }];"
      }
    },
