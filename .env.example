# Copy this file to .env and fill in your own values. Never commit .env.

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=
GEMINI_MODEL=
CLOUD_RUN_SERVICE_URL=

# Google Drive / Sheets (IDs come from the item's web address)
CASE_TRACKER_SHEET_ID=
QUOTES_FOLDER_ID=
QUOTE_TEMPLATE_SHEET_ID=

# Softr (case app)
SOFTR_API_KEY=
SOFTR_DATABASE_ID=
SOFTR_DELIVERIES_TABLE_ID=

# Optional: your own Google accounts shown by a friendly name, e.g. you@example.com=Office
OWN_ACCOUNTS=

# Where failure alerts are sent
ADMIN_EMAIL=
