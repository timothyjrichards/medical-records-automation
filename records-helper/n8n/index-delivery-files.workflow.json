    {
      "id": "31a8829b-470b-4c76-ba5c-818be9a3a09b",
      "name": "GROUP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "// One item per case that has at least one delivery with something in it. Drive was asked for one\n// file id per folder (ids only). A folder Drive could not read goes to Google anyway, which names\n// the reason. A case missing from Open Cases or without a My Documents folder is a problem.\nconst cfg = $('CONFIG').first().json;\nconst s = (v) => String(v == null ? '' : v).trim();\nconst rows = $('PICK ROWS').all().map((i) => i.json);\nconst checks = $('Any Files?').all().map((i) => i.json);\nconst cases = {};\n$('Read Open Cases').all().forEach((i) => { if (s(i.json.CaseID)) cases[s(i.json.CaseID)] = i.json; });\n\nconst out = {};\nconst problems = [];\nrows.forEach((r, n) => {\n  const c = checks[n] || {};\n  const listed = c.statusCode === 200 && c.body && Array.isArray(c.body.files);\n  if (listed && !c.body.files.length) return;   // still waiting for files\n  const oc = cases[r.caseId];\n  if (!oc) { problems.push(`${r.caseId}: case not found in Open Cases`); return; }\n  const myDocs = s(oc.FolderID_MyDocuments);\n  if (!myDocs) { problems.push(`${r.caseId}: no My Documents folder`); return; }\n  if (!out[r.caseId]) {\n    const name = s(oc['Case Name']);\n    // The plaintiff's surname, as in the delivery folder names: \"Sample, Jordan v. ...\" -> \"Sample\".\n    const head = s(name.split(/\\s+v\\.?\\s+/i)[0].replace(/\\s+et\\.?\\s+al\\.?$/i, ''));\n    const surname = s(head.split(',')[0]) || name;\n    out[r.caseId] = {\n      caseId: r.caseId, myDocs, rowNumber: oc.row_number,\n      sheetId: s(oc.FileID_FilesReceivedIndexed),\n      sheetName: cfg.SHEET_PREFIX + surname,\n      plaintiff: s(oc.Plaintiff),\n      pendingFolderId: s(oc.FolderID_PendingAssignment),   // numbered files so far\n      providersSheetId: s(oc.FileID_ProviderList),         // providers already known\n      deliveries: [],\n    };\n  }\n  out[r.caseId].deliveries.push({ row_id: r.recordId, folder_id: r.folderId, arrival_date: r.arrival });\n});\nconst staticData = $getWorkflowStaticData('global');\nstaticData.problems = problems;   // read again by FINISH, so a stop here still reports them\nconst items = Object.values(out).map((json) => ({ json }));\nif (!items.length && problems.length) throw new Error('Index Delivery Files: ' + problems.join('; '));\nreturn items;\n"
      }
    },
