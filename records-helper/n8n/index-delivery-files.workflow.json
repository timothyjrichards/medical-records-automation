    {
      "id": "f3ae3df9-1ce7-4a4b-b09f-a8492f97e38c",
      "name": "BUILD ARGS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -200
      ],
      "parameters": {
        "jsCode": "// The Google run's argument. Sheet ids are read back from Open Cases, so a sheet that was made but\n// whose id did not save is caught here instead of making a second sheet tomorrow.\nconst cfg = $('CONFIG').first().json;\nconst s = (v) => String(v == null ? '' : v).trim();\nconst saved = {};\n$('Re-read Open Cases').all().forEach((i) => { saved[s(i.json.CaseID)] = s(i.json.FileID_FilesReceivedIndexed); });\nconst problems = $getWorkflowStaticData('global').problems || [];\nconst cases = [];\n$('GROUP').all().forEach((i) => {\n  const c = i.json;\n  const sheetId = saved[c.caseId];\n  if (!sheetId) { problems.push(`${c.caseId}: sheet id did not save`); return; }\n  cases.push({ case_id: c.caseId, sheet_id: sheetId, plaintiff: c.plaintiff, pending_folder_id: c.pendingFolderId,\n               providers_sheet_id: c.providersSheetId, deliveries: c.deliveries,\n               // The Index files button means \"I am done uploading\": no 2-hour quiet wait.\n               ...(cfg.RUN_NOW ? { quiet_hours: 0 } : {}) });\n});\n$getWorkflowStaticData('global').problems = problems;\nif (!cases.length) throw new Error('Index Delivery Files: ' + problems.join('; '));\nreturn [{ json: { argument: JSON.stringify({ cases }) } }];\n"
      }
    },
