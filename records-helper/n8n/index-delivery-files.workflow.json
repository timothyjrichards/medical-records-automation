    {
      "id": "13f8176f-26f5-42d3-9cc1-db7f01b93868",
      "name": "RESULTS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        -200
      ],
      "parameters": {
        "jsCode": "// Google's reply -> one Softr update per delivery, plus the list of problems for FINISH.\n// Google replies with counts and first names only; no file or folder names reach n8n.\nconst cfg = $('CONFIG').first().json;\nconst r = $input.first().json;\nconst problems = $getWorkflowStaticData('global').problems || [];\nconst patches = [];\nlet result = null;\nif (r.statusCode === 200 && r.body && r.body.state === 'SUCCEEDED') {\n  try { result = JSON.parse(r.body.result); } catch (e) { result = null; }\n}\nif (!result || result.status !== 'ok') {\n  problems.push('Google run did not finish: ' + (result && result.stage ? result.stage : (r.body && r.body.state) || 'no answer'));\n} else {\n  for (const c of result.cases) {\n    if (c.status !== 'ok') { problems.push(`${c.case_id}: ${c.stage}`); continue; }\n    for (const d of c.deliveries) {\n      const fields = {};\n      if (d.status === 'ok') {\n        // Indexed once every PDF has a number or a suggestion; files the\n        // helper could not name make it Needs a look; files left for tomorrow keep it Uploaded.\n        const look = d.needs_look || 0;\n        fields[cfg.FF_STATUS] = d.waiting ? 'Uploaded' : look ? 'Needs a look'\n          : (d.indexed >= (d.to_index || 0) ? 'Indexed' : 'Uploaded');\n        fields[cfg.FF_LOOK] = look ? `${look} file${look === 1 ? '' : 's'} need${look === 1 ? 's' : ''} a look` : '';\n        fields[cfg.FF_ON] = d.uploaded_on;\n        fields[cfg.FF_COUNT] = d.pdfs;\n        fields[cfg.FF_OTHER] = d.other;\n        fields[cfg.FF_INDEXED] = d.indexed || 0;\n        fields[cfg.FF_NUMBERS] = d.numbers || '';\n      } else if (d.status === 'failed' && ['folder_not_found', 'folder_trashed'].includes(d.stage)) {\n        fields[cfg.FF_STATUS] = 'Needs a look';\n        fields[cfg.FF_LOOK] = d.stage === 'folder_trashed' ? 'Delivery folder is in the bin' : 'Delivery folder not found';\n      } else if (d.status === 'failed') {\n        problems.push(`${c.case_id}: delivery ${d.row_id} ${d.stage} ${d.upstream_http_status || ''}`.trim());\n        continue;\n      } else {\n        continue;   // empty, or changed in the last 2 hours: tomorrow\n      }\n      patches.push({\n        url: `https://tables-api.softr.io/api/v1/databases/${cfg.SOFTR_DB}/tables/${cfg.SOFTR_FILES}/records/${d.row_id}`,\n        body: { fields },\n      });\n    }\n  }\n}\n$getWorkflowStaticData('global').problems = problems;\nreturn [{ json: { patches, problems, cases: result && result.cases ? result.cases.length : 0 } }];\n"
      }
    },
    {
      "id": "58151a15-040b-4214-9fac-5bab900cf0af",
      "name": "One per Delivery",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        3520,
        -300
