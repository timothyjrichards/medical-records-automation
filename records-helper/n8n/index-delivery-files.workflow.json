    {
      "id": "171c289b-7e48-48a7-889d-d56872f7de60",
      "name": "CONFIG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "/* Everything that identifies a system lives here, so no other node carries a literal id.\n   Deliveries is a Softr Tables table; its API addresses fields by id. Names beside them are for the reader. */\nreturn [{\n  json: {\n    // true when a 'Run now' button in the app started this run\n    RUN_NOW: $input.first().json.runNow === true,\n    SOFTR_DB: 'YOUR_SOFTR_DATABASE_ID',\n    SOFTR_FILES: 'YOUR_SOFTR_DELIVERIES_TABLE_ID',\n    PAGE_LIMIT: 200,   // the Softr Tables API caps a page at 200 and silently clamps anything bigger\n\n    FF_DATE: 'FIELD_ID', FF_CASE_ID: 'FIELD_ID',\n    FF_FOLDER: 'FIELD_ID',      // Folder ID\n    FF_STATUS: 'FIELD_ID',      // Status - SELECT: Waiting for files / Uploaded / Indexed / Needs a look\n    FF_LOOK: 'FIELD_ID',        // Needs a look - short reason, never a file name\n    FF_BY: 'FIELD_ID', FF_ON: 'FIELD_ID', FF_COUNT: 'FIELD_ID', FF_OTHER: 'FIELD_ID',\n    FF_INDEXED: 'FIELD_ID', FF_NUMBERS: 'FIELD_ID',   // Indexed count, Numbers used\n\n    // Only deliveries that are still moving. \"Indexed\" is set by the naming step.\n    STATUSES: ['Waiting for files', 'Uploaded'],\n    // About 1-3 deliveries arrive a day. More than this many open ones means a filter is wrong.\n    MAX_ROWS: 60,\n    SHEET_PREFIX: 'Files Received Index \u2013 ',\n  },\n}];\n"
      }
    },
    {
      "id": "9be8f92e-6eb1-452a-8ec1-a942d88e5513",
      "name": "Fetch Files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "url": "={{ 'https://tables-api.softr.io/api/v1/databases/' + $('CONFIG').first().json.SOFTR_DB + '/tables/' + $('CONFIG').first().json.SOFTR_FILES + '/records' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "={{ $('CONFIG').first().json.PAGE_LIMIT }}"
            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "name": "offset",
                    "value": "={{ $pageCount * $('CONFIG').first().json.PAGE_LIMIT }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ $response.body.data.length < $('CONFIG').first().json.PAGE_LIMIT }}",
              "limitPagesFetched": true,
              "maxRequests": 50
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Softr API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "2ed2c2a6-126d-4766-bb61-ffe1f8bd3b76",
      "name": "PICK ROWS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Deliveries with a folder that are waiting for files or already uploaded. One item per row.\nconst cfg = $('CONFIG').first().json;\nconst s = (v) => String(v == null ? '' : v).trim();\nconst label = (v) => (v && typeof v === 'object' ? s(v.label) : s(v));\nconst f = (r, id) => (r.fields || {})[id];\n\nconst rows = $input.all().flatMap((i) => i.json.data || []);\nconst todo = rows.filter((r) => s(f(r, cfg.FF_FOLDER)) && s(f(r, cfg.FF_CASE_ID)) &&\n  cfg.STATUSES.includes(label(f(r, cfg.FF_STATUS))));\nif (todo.length > cfg.MAX_ROWS) {\n  throw new Error(`${todo.length} open deliveries, more than the limit of ${cfg.MAX_ROWS}. Nothing was done.`);\n}\nreturn todo.map((r) => ({ json: {\n  recordId: r.id,\n  caseId: s(f(r, cfg.FF_CASE_ID)),\n  folderId: s(f(r, cfg.FF_FOLDER)),\n  arrival: s(f(r, cfg.FF_DATE)).slice(0, 10),\n} }));\n"
      }
    },
    {
      "id": "18804c80-694a-461d-96b3-10cb2166544e",
      "name": "Any Files?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ \"'\" + $json.folderId + \"' in parents and trashed=false\" }}"
            },
            {
              "name": "pageSize",
              "value": "1"
            },
            {
              "name": "fields",
              "value": "files(id)"
            },
            {
              "name": "supportsAllDrives",
              "value": "true"
            },
            {
              "name": "includeItemsFromAllDrives",
              "value": "true"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Drive account"
        }
      },
      "retryOnFail": true,
